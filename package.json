{
  "name": "@natlibfi/aleph-record-caretaker",
  "version": "2.0.0-alpha.2",
  "description": "A service that applies Melinda-specific conversions when records change in Aleph",
  "author": {
    "name": "The National Library of Finland"
  },
  "homepage": "https://github.com/NatLibFi/aleph-record-caretaker",
  "bugs": {
    "url": "https://github.com/NatLibFi/aleph-record-caretaker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:NatLibFi/aleph-record-caretaker.git"
  },
  "license": "Apache-2.0",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "mocha \"lib/**/*.spec.js\"",
    "test:watch": "mocha lib/*.spec.js -w",
    "coverage": "nyc --reporter=text --reporter=html mocha 'lib/**/*.spec.js'",
    "publish-to-npm": "npm test && npm publish --access=public"
  },
  "nyc": {
    "all": true,
    "include": [
      "index.js",
      "lib/**/*.js"
    ],
    "exclude": [
      "**/*.spec.js",
      "lib/test-utils.js",
      "lib/punctuation-test.examples",
      "lib/melinda-marc-record-utils/**"
    ]
  },
  "dependencies": {
    "@natlibfi/marc-record": "11.0.3",
    "@natlibfi/marc-record-serializers": "^11.0.5",
    "@natlibfi/marc-record-validators-melinda": "^13.0.5",
    "@natlibfi/melinda-api-client": "^2.0.0",
    "@natlibfi/melinda-marc-record-utils": "^1.2.1",
    "debug": "^4.4.3",
    "es6-promisify": "^7.0.0",
    "isomorphic-fetch": "^3.0.0",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "node-fetch": "^3.3.2",
    "oracledb": "^5.5.0",
    "winston": "^3.19.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "chai": "^6.2.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "mocha": "^12.0.0",
    "nyc": "^18.0.0",
    "proxyquire": "^2.1.3",
    "sinon": "^22.1.0"
  },
  "tempDependencies": {
    "oracledb": "^5.5.0"
  }
}
